"Generator (g): {g}\")\n","    print(f\"Secret Exponent (x): {x}\")\n","    print(f\"Public Key (y = g^x mod p): {y}\")\n","    print(\"-\" * 30)\n","    return p, g, q, x, y\n","\n","def interactive_schnorr_honest(p, g, q, x, y):\n","    k = random.randint(1, q - 1)\n","    t = pow(g, k, p)\n","    e = random.randint(1, q - 1)\n","    s = (k - x * e) % q\n","    g_s = pow(g, s, p)\n","    y_e = pow(y, e, p)\n","    V_check = (g_s * y_e) % p\n","    result = V_check == t\n","    print(\"### Honest Interactive Run ###\")\n","    print(f\"Prover commitment (t): {t}\")\n","    print(f\"Verifier challenge (e): {e}\")\n","    print(f\"Prover response (s): {s}\")\n","    print(f\"Verification Check: g^s * y^e mod p = {V_check}\")\n","    print(f\"Verification: {'Passed' if result else 'Failed'}\")\n","    print(\"-\" * 30)\n","    return result\n","\n","def interactive_schnorr_cheating_attempt(p, g, q, y):\n","    s_prime = random.randint(1, q - 1)\n","    e_guess = random.randint(1, q - 1)\n","    g_s = pow(g, s_prime, p)\n","    y_e = pow(y, e_guess, p)\n","    t_prime = (g_s * y_e) % p\n","    e_actual = random.randint(1, q - 1)\n","    g_s = pow(g, s_prime, p)\n","    y_e_actual = pow(y, e_actual, p)\n","    V_check = (g_s * y_e_actual) % p\n","    result = V_check == t_prime\n","    print(\"### Cheating Attempt ###\")\n","    print(f\"Prover fakes t: {t_prime}\")\n","    print(f\"Verifier challenge (e): {e_actual}\")\n","    print(f\"Cheater's guess (e_guess): {e_guess}\")\n","    print(f\"Verification Check: g^s * y^e mod p = {V_check}\")\n","    print(f\"Verification: {'Passed' if result else 'Failed'}\")\n","    print(f\"Success was {'by chance' if result else 'Failed'}\")\n","    print(\"-\" * 30)\n","    return result\n","\n","def measure_cheating_probability(p, g, q, y, attempts=100):\n","    success_count = 0\n","\n","    for _ in range(attempts):\n","        s_prime = random.randint(1, q - 1)\n","        e_guess = random.randint(1, q - 1)\n","        t_prime = (pow(g, s_prime, p) * pow(y, e_guess, p)) % p\n","        e_actual = random.randint(1, q - 1)\n","        V_check = (pow(g, s_prime, p) * pow(y, e_actual, p)) % p\n","\n","        if V_check == t_prime:\n","            success_count += 1\n","\n","    success_rate = success_count / attempts\n","    expected_prob = 1 / q\n","\n","    print(\"### Cheating Probability Experiment ###\")\n","    print(f\"Total attempts: {attempts}\")\n","    print(f\"Successful cheats: {success_count}\")\n","    print(f\"Cheating success rate (Measured): {success_rate:.4f}\")\n","    print(f\"Expected probability (1/q): {expected_prob:.4f}\")\n","    print(\"-\" * 30)\n","\n","def fiat_shamir_schnorr(p, g, q, x, y, message):\n","    k = random.randint(1, q - 1)\n","    t = pow(g, k, p)\n","    hash_input = f\"{t}{message}\".encode('utf-8')\n","    hash_value = int(hashlib.sha256(hash_input).hexdigest(), 16)\n","    e = (hash_value % (q - 1)) + 1\n","    s = (k - x * e) % q\n","    g_s = pow(g, s, p)\n","    y_e = pow(y, e, p)\n","    V_check = (g_s * y_e) % p\n","    hash_input_v = f\"{t}{message}\".encode('utf-8')\n","    hash_value_v = int(hashlib.sha256(hash_input_v).hexdigest(), 16)\n","    e_v = (hash_value_v % (q - 1)) + 1\n","    result = (V_check == t) and (e == e_v)\n","    print(\"### Fiat-Shamir (Non-Interactive) Run ###\")\n","    print(f\"Prover commitment (t): {t}\")\n","    print(f\"Hash-based challenge (e): {e}\")\n","    print(f\"Prover response (s): {s}\")\n","    print(f\"Verification Check: g^s * y^e mod p = {V_check}\")\n","    print(f\"Verification: {'Passed' if result else 'Failed'}\")\n","    print(\"-\" * 30)\n","    return result\n","\n","if __name__ == \"__main__\":\n","    p, g, q, x, y = initialize_params()\n","    interactive_schnorr_honest(p, g, q, x, y)\n","    interactive_schnorr_cheating_attempt(p, g, q, y)\n","    fiat_shamir_schnorr(p, g, q, x, y, message=\"Transaction_123\")\n","    measure_cheating_probability(p, g, q, y, attempts=100)"]}]}