{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1jmAMsNOD88tdRwc6F359MQS-SJui4-TA","timestamp":1765397017812},{"file_id":"1frDJ8QHdv_Tz12fco-CgrVBDIH_k1Zft","timestamp":1765396765018}],"authorship_tag":"ABX9TyO+TayeVab99ogajaIzHI+s"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["\n","# Import necessary library for random selection (optional, but good for larger logic)\n","import math\n","\n","def gcd(a, b):\n","    \"\"\"Compute the greatest common divisor of a and b\"\"\"\n","    while b:\n","        a, b = b, a % b\n","    return a\n","\n","def mod_inverse(e, phi):\n","    \"\"\"Compute the modular multiplicative inverse of e modulo phi\"\"\"\n","    # Using extended Euclidean algorithm logic or pow function in Python 3.8+\n","    return pow(e, -1, phi)\n","\n","def generate_keypair(p, q):\n","    \"\"\"\n","    Generates the public (e, n) and private (d, n) keys.\n","    [span_10](start_span)Steps based on Lab Instructions[span_10](end_span):\n","    1. Compute n = p * q\n","    2. Compute phi = (p - 1) * (q - 1)\n","    3. Choose e such that 1 < e < phi and gcd(e, phi) = 1\n","    4. Compute d such that (d * e) % phi = 1\n","    \"\"\"\n","    n = p * q\n","    phi = (p - 1) * (q - 1)\n","\n","    # Choose e (commonly used small value or generated)\n","    # For this lab, we select a value coprime to phi manually or iteratively\n","    e = 7 # Starting check from 7 as per sample logic\n","    while gcd(e, phi) != 1:\n","        e += 1\n","\n","    d = mod_inverse(e, phi)\n","\n","    return ((e, n), (d, n), phi)\n","\n","def encrypt(m, e, n):\n","    \"\"\"Encrypts message m using public key (e, n)\"\"\"\n","    # [span_11](start_span)Ciphertext c = m^e mod n[span_11](end_span)\n","    return pow(m, e, n)\n","\n","def decrypt(c, d, n):\n","    \"\"\"Decrypts ciphertext c using private key (d, n)\"\"\"\n","    # Plaintext m = c^d mod n\n","    return pow(c, d, n)\n","\n","# --- MAIN EXECUTION LOG ---\n","print(\"--- RSA Encryption & Homomorphic Property Lab Log ---\")\n","\n","# 1. Generate small RSA key pair (Using sample inputs for consistency)\n","# [span_12](start_span)Sample Input: p=11, q=13[span_12](end_span)\n","p = 11\n","q = 13\n","\n","public_key, private_key, phi = generate_keypair(p, q)\n","e, n = public_key\n","d, n_priv = private_key\n","\n","print(f\"Chosen Primes: p={p}, q={q}\")\n","print(f\"Computed n={n}, Phi={phi}\")\n","print(f\"Public Key (e, n) = ({e}, {n})\")\n","print(f\"Private Key (d, n) = ({d}, {n})\")\n","print(\"-\" * 30)\n","\n","# 2. Select two plaintexts\n","# [span_13](start_span)Sample Input: m1=5, m2=9[span_13](end_span)\n","m1 = 5\n","m2 = 9\n","print(f\"Original Plaintexts: m1={m1}, m2={m2}\")\n","\n","# 3. Encrypt both messages\n","c1 = encrypt(m1, e, n)\n","c2 = encrypt(m2, e, n)\n","print(f\"Encrypted E(m1) = {c1}\")\n","print(f\"Encrypted E(m2) = {c2}\")\n","\n","# 4. Verify Homomorphic Property\n","# [span_14](start_span)Property: E(m1) * E(m2) mod n should correspond to m1 * m2 mod n[span_14](end_span)\n","\n","# Step A: Multiply Ciphertexts\n","c_product = (c1 * c2) % n\n","print(f\"Ciphertext Product (E(m1)*E(m2) mod n) = {c_product}\")\n","\n","# Step B: Decrypt the product\n","decrypted_product = decrypt(c_product, d, n)\n","print(f\"Decrypted Result from Product = {decrypted_product}\")\n","\n","# Step C: Calculate Expected Result (m1 * m2 mod n)\n","expected_plaintext = (m1 * m2) % n\n","print(f\"Expected Result (m1 * m2 mod n) = {expected_plaintext}\")\n","\n","# Verification\n","print(\"-\" * 30)\n","if decrypted_product == expected_plaintext:\n","    print(\"SUCCESS: Homomorphic property verified!\")\n","    print(f\"Result: E(m1)*E(m2) == E(m1*m2) mod n\")\n","else:\n","    print(\"FAILURE: Property verification failed.\")"],"metadata":{"id":"8-3EAV1t02Os","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":17653965